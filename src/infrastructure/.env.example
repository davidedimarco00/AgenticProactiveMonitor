# ==================================================
# AgenticProactiveMonitor - local development environment
# Do not use these values in production.
# ==================================================

# ==================================================
# Project
# ==================================================
PROJECT_NAME=AgenticProactiveMonitor
APP_ENV=local-dev
TELEMETRY_ENVIRONMENT=thesis-lab

# ==================================================
# OpenSearch
# ==================================================
OPENSEARCH_VERSION=3.6.0
OPENSEARCH_CLUSTER_NAME=agentic-monitor-cluster
OPENSEARCH_NODE_NAME=agentic-opensearch-node

OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_HTTP_PORT=9200
OPENSEARCH_PERFORMANCE_ANALYZER_PORT=9600

OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_INTERNAL_HTTP_URL=http://opensearch:9200
OPENSEARCH_HOSTS=["https://opensearch:9200"]

OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=Davide00+*
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Davide00+*

OPENSEARCH_SSL_VERIFICATIONMODE=none
OPENSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"

# ==================================================
# OpenSearch Dashboards
# ==================================================
OPENSEARCH_DASHBOARDS_VERSION=3.6.0
OPENSEARCH_DASHBOARDS_PORT=5601

# ==================================================
# Qdrant - Vector Database for RAG
# ==================================================
QDRANT_HOST=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Internal Docker URL, used by containers
QDRANT_URL=http://qdrant:6333

# Public URL, used from host machine / browser / Postman
QDRANT_PUBLIC_URL=http://localhost:6333

QDRANT_COLLECTION=agentic_knowledge_base
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=Cosine

# ==================================================
# RAG
# ==================================================
RAG_KNOWLEDGE_BASE_PATH=/knowledge-base
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5

EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VECTOR_SIZE=384

# ==================================================
# Ollama - Local LLM Runtime
# ==================================================
OLLAMA_PORT=11434
OLLAMA_HOST=0.0.0.0:11434

# Internal Docker URL, used by containers
OLLAMA_BASE_URL=http://ollama:11434

# Public URL, used from host machine / browser / Postman
OLLAMA_PUBLIC_URL=http://localhost:11434

OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# Default local LLM model used by agents / RAG pipeline
OLLAMA_DEFAULT_MODEL=llama3.2

# ==================================================
# NVIDIA GPU support for local Docker runtime
# ==================================================
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ==================================================
# Open WebUI
# ==================================================
OPEN_WEBUI_PORT=3000
WEBUI_AUTH=true
WEBUI_SECRET_KEY=agentic-proactive-monitor-secret-key-change-me

# ==================================================
# Monitored machines defaults
# ==================================================
LOG_INTERVAL=3

# ==================================================
# Monitored machine 01
# ==================================================
MACHINE_01_HOST_ID=machine-01
MACHINE_01_ROLE=application-server
MACHINE_01_LOG_LEVEL_PROFILE=normal
MACHINE_01_LATENCY_MIN=10
MACHINE_01_LATENCY_MAX=500
MACHINE_01_LOG_INTERVAL=3

# ==================================================
# Monitored machine 02
# ==================================================
MACHINE_02_HOST_ID=machine-02
MACHINE_02_ROLE=database-server
MACHINE_02_LOG_LEVEL_PROFILE=normal
MACHINE_02_LATENCY_MIN=20
MACHINE_02_LATENCY_MAX=700
MACHINE_02_LOG_INTERVAL=3

# ==================================================
# Monitored machine 03
# ==================================================
MACHINE_03_HOST_ID=machine-03
MACHINE_03_ROLE=api-gateway
MACHINE_03_LOG_LEVEL_PROFILE=unstable
MACHINE_03_LATENCY_MIN=30
MACHINE_03_LATENCY_MAX=900
MACHINE_03_LOG_INTERVAL=3

# ==================================================
# Monitored machine 04
# ==================================================
MACHINE_04_HOST_ID=machine-04
MACHINE_04_ROLE=worker-node
MACHINE_04_LOG_LEVEL_PROFILE=normal
MACHINE_04_LATENCY_MIN=40
MACHINE_04_LATENCY_MAX=1100
MACHINE_04_LOG_INTERVAL=3

# ==================================================
# Monitored machine 05
# ==================================================
MACHINE_05_HOST_ID=machine-05
MACHINE_05_ROLE=edge-node
MACHINE_05_LOG_LEVEL_PROFILE=critical
MACHINE_05_LATENCY_MIN=50
MACHINE_05_LATENCY_MAX=1300
MACHINE_05_LOG_INTERVAL=3