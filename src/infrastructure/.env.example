# =============================================================================
# Core images
# =============================================================================
CURL_IMAGE_VERSION=8.10.1

OPENSEARCH_VERSION=3.6.0
OPENSEARCH_DASHBOARDS_VERSION=3.6.0
QDRANT_VERSION=v1.18.1
OLLAMA_VERSION=0.32.5
OPEN_WEBUI_VERSION=v0.9.5
PROSODY_VERSION=13.0

# =============================================================================
# Host ports
# All published ports are bound to 127.0.0.1 by docker-compose.yml.
# =============================================================================
OPENSEARCH_HTTP_PORT=9200
OPENSEARCH_PERFORMANCE_ANALYZER_PORT=9600
OPENSEARCH_DASHBOARDS_PORT=5601
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
OLLAMA_PORT=11434
OPEN_WEBUI_PORT=3000
XMPP_CLIENT_PORT=5222

# =============================================================================
# OpenSearch and telemetry
# =============================================================================
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
LOG_INTERVAL=3
DASHBOARDS_WAIT_SECONDS=300
DETECTOR_WAIT_SECONDS=300
DETECTOR_MIN_DOCUMENTS=20

# =============================================================================
# Ollama
# The chat model is also the model currently referenced by agents.yaml.
# nomic-embed-text produces 768-dimensional embeddings.
# =============================================================================
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_WAIT_SECONDS=300

# =============================================================================
# Qdrant RAG collection
# Change QDRANT_VECTOR_SIZE when changing to an embedding model with a
# different output dimension.
# =============================================================================
QDRANT_LOG_LEVEL=INFO
QDRANT_COLLECTION=thesis-knowledge-base
QDRANT_VECTOR_SIZE=768
QDRANT_DISTANCE=Cosine
QDRANT_WAIT_SECONDS=120

# =============================================================================
# Open WebUI
# Replace this value before the first start. The first registered user becomes
# the administrator when authentication and signup are enabled.
# =============================================================================
OPEN_WEBUI_AUTH=true
OPEN_WEBUI_ENABLE_SIGNUP=true
OPEN_WEBUI_SECRET_KEY=replace-with-a-long-random-secret

# =============================================================================
# SPADE / Prosody XMPP
# The domain must remain reachable as a Docker network alias. The default
# matches the JIDs already defined in src/agentic_system/config/agents.yaml.
# Registration is enabled only for this isolated local thesis environment.
# =============================================================================
XMPP_DOMAIN=xmpp
XMPP_ALLOW_REGISTRATION=true
XMPP_COORDINATOR_PASSWORD=replace-coordinator-password
XMPP_EVIDENCE_PASSWORD=replace-evidence-password
XMPP_REASONING_PASSWORD=replace-reasoning-password
XMPP_CRITIC_PASSWORD=replace-critic-password
XMPP_REMEDIATION_PASSWORD=replace-remediation-password
