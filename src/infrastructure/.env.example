# ==================================================
# AgenticProactiveMonitor - local thesis environment
# Security is intentionally disabled for OpenSearch.
# ==================================================

# ==================================================
# Project
# ==================================================
PROJECT_NAME=AgenticProactiveMonitor
APP_ENV=local-dev
TELEMETRY_ENVIRONMENT=thesis-lab

# ==================================================
# OpenSearch - no TLS / no authentication
# ==================================================
OPENSEARCH_VERSION=3.6.0
OPENSEARCH_CLUSTER_NAME=agentic-monitor-cluster
OPENSEARCH_NODE_NAME=agentic-opensearch-node

OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_HTTP_PORT=9200
OPENSEARCH_PERFORMANCE_ANALYZER_PORT=9600

OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INTERNAL_HTTP_URL=http://opensearch:9200
OPENSEARCH_HOSTS=["http://opensearch:9200"]

OPENSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"

# ==================================================
# OpenSearch Dashboards
# ==================================================
OPENSEARCH_DASHBOARDS_VERSION=3.6.0
OPENSEARCH_DASHBOARDS_PORT=5601

# ==================================================
# Qdrant - Vector Database for RAG
# ==================================================
QDRANT_HOST=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_PUBLIC_URL=http://localhost:6333
QDRANT_COLLECTION=agentic_knowledge_base
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=Cosine

# ==================================================
# RAG
# ==================================================
RAG_KNOWLEDGE_BASE_PATH=/knowledge-base
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_VECTOR_SIZE=384

# ==================================================
# Ollama - Local LLM Runtime
# ==================================================
OLLAMA_PORT=11434
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PUBLIC_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MODEL=llama3.2:3b

# ==================================================
# NVIDIA GPU support
# ==================================================
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ==================================================
# Open WebUI
# ==================================================
OPEN_WEBUI_PORT=3000
WEBUI_AUTH=true
WEBUI_SECRET_KEY=agentic-proactive-monitor-secret-key-change-me

# ==================================================
# XMPP / SPADE
# ==================================================
XMPP_PORT=5222

# ==================================================
# Monitored machines defaults
# ==================================================
LOG_INTERVAL=3
