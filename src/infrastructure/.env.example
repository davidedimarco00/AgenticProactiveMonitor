# =============================================================================
# Core images
# =============================================================================
CURL_IMAGE_VERSION=8.10.1

OPENSEARCH_VERSION=3.6.0
OPENSEARCH_DASHBOARDS_VERSION=3.6.0
QDRANT_VERSION=v1.18.1
OPEN_WEBUI_VERSION=v0.9.5
PROSODY_VERSION=13.0

# =============================================================================
# Host ports
# All published Docker ports are bound to 127.0.0.1 by docker-compose.yml.
# Ollama runs natively on Windows and is not published by Docker.
# =============================================================================
OPENSEARCH_HTTP_PORT=9200
OPENSEARCH_PERFORMANCE_ANALYZER_PORT=9600
OPENSEARCH_DASHBOARDS_PORT=5601
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
OPEN_WEBUI_PORT=3000
XMPP_CLIENT_PORT=5222
AGENTIC_DASHBOARD_PORT=5050
AGENTIC_BACKEND_HEALTH_PORT=8081
TECHNICAL_LEAD_HEALTH_PORT=8101
SYSTEM_ENGINEER_HEALTH_PORT=8102
NETWORK_ENGINEER_HEALTH_PORT=8103
APPLICATION_ENGINEER_HEALTH_PORT=8104
SOFTWARE_DEVELOPER_HEALTH_PORT=8105

# =============================================================================
# OpenSearch and telemetry
# =============================================================================
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
LOG_INTERVAL=3
DASHBOARDS_WAIT_SECONDS=300
OBSERVABILITY_NETWORK_NAME=agentic-monitoring-net
MONITORED_HOSTS=traffic-generator api-gateway processing-service data-service worker-service

# The detector bootstrap waits for 40 complete one-minute intervals of CPU and
# RAM history on every monitored service before creating the detectors.
# All OpenSearch Anomaly Detection detectors are SINGLE_ENTITY.
DETECTOR_WAIT_SECONDS=3600
DETECTOR_REQUIRED_INTERVALS=40

# =============================================================================
# Ollama on the Windows host
# =============================================================================
# Docker Desktop resolves host.docker.internal to the Windows host.
OLLAMA_HOST_URL=http://host.docker.internal:11434

# Main model for reasoning, diagnosis and text generation
OLLAMA_CHAT_MODEL=gemma4:e2b

# Primary and fallback models for agent tool/function calling
OLLAMA_TOOL_MODEL=qwen3.5:4b
OLLAMA_FALLBACK_TOOL_MODEL=qwen2.5:latest

# Embedding model for monitored-system RAG. The 30M Granite model returns
# 384-dimensional vectors.
OLLAMA_EMBEDDING_MODEL=ibm/granite-embedding:30m

# =============================================================================
# Qdrant monitored-system knowledge base
# =============================================================================
QDRANT_LOG_LEVEL=INFO
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=Cosine
QDRANT_WAIT_SECONDS=120

# The only project-managed RAG collection. It contains documentation specific
# to the monitored Notes Platform and is shared by all specialist agents.
QDRANT_MONITORED_SYSTEM_COLLECTION=monitored-system
QDRANT_COLLECTIONS=monitored-system

# Manifest-driven ingestion. On infrastructure startup, the ingestion container
# reads the monitored-system manifest, embeds its listed Markdown documents and
# replaces only points previously managed by manifest-ingest.
KNOWLEDGE_INGEST_WAIT_SECONDS=120
KNOWLEDGE_INGEST_EMBED_BATCH_SIZE=16
KNOWLEDGE_INGEST_UPSERT_BATCH_SIZE=64

# =============================================================================
# Knowledge Base Web UI
# Flask application used to upload, inspect, search and delete documents stored
# in the monitored-system Qdrant collection.
# =============================================================================
KNOWLEDGE_BASE_UI_PORT=5000
KNOWLEDGE_BASE_MAX_UPLOAD_MB=25
KNOWLEDGE_BASE_CHUNK_SIZE_WORDS=220
KNOWLEDGE_BASE_CHUNK_OVERLAP_WORDS=40
KNOWLEDGE_BASE_SEARCH_LIMIT=5
KNOWLEDGE_BASE_FLASK_SECRET_KEY=change-this-flask-secret

# =============================================================================
# Agentic System backend
# One Docker container hosts five logically and software-distinct SPADE agents.
# BDI state, ReAct execution and inter-agent communication are implemented in
# the backend package; OpenSearch/Qdrant access is intentionally mediated by MCP.
# Each agent also exposes its own HTTP /health and WebSocket /ws/health endpoint
# on ports 8101-8105 for real-time operator observability.
# =============================================================================
AGENT_LLM_CONTEXT=8192
AGENT_MAX_LLM_CONCURRENCY=2

# =============================================================================
# Agentic System Operator Dashboard
# Flask application used by the human operator to inspect taken-in-charge
# anomalies, diagnoses, remediation guidance and per-agent operational activity.
# Incident and agent-observability records are persisted in monthly OpenSearch
# indices.
# =============================================================================
INCIDENT_INDEX_PREFIX=agentic-incidents
AGENT_EVENT_INDEX_PREFIX=agentic-agent-events
DASHBOARD_REQUEST_TIMEOUT_SECONDS=2.5

# =============================================================================
# Open WebUI
# Replace this value before the first start. The first registered user becomes
# the administrator when authentication and signup are enabled.
# =============================================================================
RAG_TOP_K=5
OPEN_WEBUI_AUTH=true
OPEN_WEBUI_ENABLE_SIGNUP=true
OPEN_WEBUI_SECRET_KEY=change-this-secret-before-first-start

# =============================================================================
# SPADE / Prosody XMPP
# The five agent accounts are provisioned by the xmpp-bootstrap one-shot service
# before Prosody and the backend start. SPADE therefore authenticates existing
# accounts with auto_register disabled. STARTTLS is required on port 5222.
# =============================================================================
XMPP_DOMAIN=xmpp
XMPP_ALLOW_REGISTRATION=false
XMPP_AUTO_REGISTER=false
XMPP_TECHNICAL_LEAD_PASSWORD=change-this-local-password
XMPP_SYSTEM_ENGINEER_PASSWORD=change-this-local-password
XMPP_NETWORK_ENGINEER_PASSWORD=change-this-local-password
XMPP_APPLICATION_ENGINEER_PASSWORD=change-this-local-password
XMPP_SOFTWARE_DEVELOPER_PASSWORD=change-this-local-password
