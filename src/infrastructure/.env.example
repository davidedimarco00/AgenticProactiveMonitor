# =============================================================================
# Core images
# =============================================================================
CURL_IMAGE_VERSION=8.10.1

OPENSEARCH_VERSION=3.6.0
OPENSEARCH_DASHBOARDS_VERSION=3.6.0
QDRANT_VERSION=v1.18.1
OPEN_WEBUI_VERSION=v0.9.5
PROSODY_VERSION=13.0

# =============================================================================
# Host ports
# All published Docker ports are bound to 127.0.0.1 by docker-compose.yml.
# Ollama runs natively on Windows and is not published by Docker.
# =============================================================================
OPENSEARCH_HTTP_PORT=9200
OPENSEARCH_PERFORMANCE_ANALYZER_PORT=9600
OPENSEARCH_DASHBOARDS_PORT=5601
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
OPEN_WEBUI_PORT=3000
XMPP_CLIENT_PORT=5222
AGENTIC_DASHBOARD_PORT=5050

# =============================================================================
# OpenSearch and telemetry
# =============================================================================
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
LOG_INTERVAL=3
DASHBOARDS_WAIT_SECONDS=300
OBSERVABILITY_NETWORK_NAME=agentic-monitoring-net
MONITORED_HOSTS=traffic-generator api-gateway processing-service data-service worker-service

# The detector bootstrap waits for 40 complete one-minute intervals of CPU and
# RAM history on every monitored service before creating the detectors.
# All OpenSearch Anomaly Detection detectors are SINGLE_ENTITY.
DETECTOR_WAIT_SECONDS=3600
DETECTOR_REQUIRED_INTERVALS=40

# =============================================================================
# Ollama on the Windows host
# =============================================================================
# Docker Desktop resolves host.docker.internal to the Windows host.
OLLAMA_HOST_URL=http://host.docker.internal:11434

# Main model for reasoning, diagnosis and text generation
OLLAMA_CHAT_MODEL=gemma4:e2b

# Primary and fallback models for agent tool/function calling
OLLAMA_TOOL_MODEL=qwen3.5:4b
OLLAMA_FALLBACK_TOOL_MODEL=qwen2.5:latest

# Embedding model for RAG. The 30M Granite model returns 384-dimensional vectors.
OLLAMA_EMBEDDING_MODEL=ibm/granite-embedding:30m

# =============================================================================
# Qdrant knowledge base
# =============================================================================
QDRANT_LOG_LEVEL=INFO
QDRANT_COLLECTION=thesis-knowledge-base
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=Cosine
QDRANT_WAIT_SECONDS=120

# =============================================================================
# Knowledge Base Web UI
# Flask application used to upload, inspect, search and delete knowledge-base
# documents stored in Qdrant.
# =============================================================================
KNOWLEDGE_BASE_UI_PORT=5000
KNOWLEDGE_BASE_MAX_UPLOAD_MB=25
KNOWLEDGE_BASE_CHUNK_SIZE_WORDS=220
KNOWLEDGE_BASE_CHUNK_OVERLAP_WORDS=40
KNOWLEDGE_BASE_SEARCH_LIMIT=5
KNOWLEDGE_BASE_FLASK_SECRET_KEY=change-this-flask-secret

# =============================================================================
# Agentic System Operator Dashboard
# Flask application used by the human operator to inspect taken-in-charge
# anomalies, ReAct investigation traces, diagnoses and remediation guidance.
# Incident records are persisted in OpenSearch using monthly indices.
# =============================================================================
INCIDENT_INDEX_PREFIX=agentic-incidents
DASHBOARD_REQUEST_TIMEOUT_SECONDS=2.5

# =============================================================================
# Open WebUI
# Replace this value before the first start. The first registered user becomes
# the administrator when authentication and signup are enabled.
# =============================================================================
RAG_TOP_K=5
OPEN_WEBUI_AUTH=true
OPEN_WEBUI_ENABLE_SIGNUP=true
OPEN_WEBUI_SECRET_KEY=1bf7b32aaac032964fd20307ad477a009ee33792e8d27c1da2a3da6be056f1f4

# =============================================================================
# SPADE / Prosody XMPP
# The domain must remain reachable as a Docker network alias. The default
# matches the JIDs already defined in src/agentic_system/config/agents.yaml.
# Registration is enabled only for this isolated local thesis environment.
# =============================================================================
XMPP_DOMAIN=xmpp
XMPP_ALLOW_REGISTRATION=true
XMPP_COORDINATOR_PASSWORD=Davide00+
XMPP_EVIDENCE_PASSWORD=Davide00+
XMPP_REASONING_PASSWORD=Davide00+
XMPP_CRITIC_PASSWORD=Davide00+
XMPP_REMEDIATION_PASSWORD=Davide00+
