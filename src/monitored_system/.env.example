# Standalone monitored-system defaults
LOG_INTERVAL=3
OBSERVABILITY_NETWORK_NAME=agentic-monitoring-net

# Internal service communication
REQUEST_TIMEOUT_SECONDS=3

# Flask web application
FLASK_SECRET_KEY=change-me-for-local-use

# Synthetic user traffic
TRAFFIC_REQUEST_TIMEOUT_SECONDS=5
TRAFFIC_MIN_INTERVAL_SECONDS=2
TRAFFIC_MAX_INTERVAL_SECONDS=5

# Network fault injection
TOXIPROXY_VERSION=2.12.0

# Controlled fault injection
MAX_FAULT_DELAY_MS=30000
