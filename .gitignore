# ============================================================
# AgenticProactiveMonitor - .gitignore
# ============================================================


# ============================================================
# PYTHON
# ============================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Virtual environments
.venv/
.venv-*/
venv/
env/
ENV/
env.bak/
venv.bak/

# pytest
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Ruff
.ruff_cache/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyright
.pyright/

# tox / nox
.tox/
.nox/

# Jupyter
.ipynb_checkpoints/

# Python temporary files
*.pyc
*.pyo
*.pyd


# ============================================================
# ENVIRONMENT / SECRETS
# ============================================================

.env
.env.*
!.env.example

*.pem
*.key


# ============================================================
# INTELLIJ / JETBRAINS
# ============================================================

.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# IntelliJ output
out/

# CMake
cmake-build-*/

# Plugin-specific files
atlassian-ide-plugin.xml

# Sonar
.sonar/
.scannerwork/


# ============================================================
# VISUAL STUDIO CODE
# ============================================================

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

*.vsix

# Local history
.history/
.ionide


# ============================================================
