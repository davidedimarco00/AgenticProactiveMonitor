npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.yarn/cache/
.yarn/unplugged/

# Do NOT ignore root package-lock.json by default.
# Lock files should normally be version controlled.


# ============================================================
# DOCUMENTATION / VITEPRESS
# ============================================================

/docs/node_modules/
/docs/.vitepress/cache/
/docs/.vitepress/dist/

# Existing project choice: ignore docs package-lock
/docs/package-lock.json


